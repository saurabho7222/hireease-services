# Designated Super Admin email (The only account that automatically receives direct Admin Panel access)
SUPER_ADMIN_EMAIL=admin@hireease.com

# Workspace recruiter setup activation code
ADMIN_SETUP_KEY=

# Real Google OAuth 2.0 Credentials (Optional for local dev - if omitted, built-in Google Account Chooser is used)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Real LinkedIn OAuth 2.0 Credentials (Optional for local dev - if omitted, built-in LinkedIn Account Chooser is used)
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Real GitHub OAuth 2.0 Credentials (Optional for local dev - if omitted, built-in GitHub Account Chooser is used)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Resend API Key for live email dispatch (Optional - if omitted, emails are saved into SQLite outbox)
# RESEND_API_KEY=
