# ==============================================================================
# HireEase Services - Production Environment Configuration (.env)
# Copy this file to .env on your VPS: cp .env.production.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Super Admin Privileges
# ------------------------------------------------------------------------------
# The primary administrator email that receives immediate, automatic Super Admin
# access to the Recruiter ATS and Admin Dashboard (/admin).
SUPER_ADMIN_EMAIL=admin@hireease.com

# Workspace recruiter setup activation code for granting recruiter seats
ADMIN_SETUP_KEY=your-secure-random-activation-key-here

# ------------------------------------------------------------------------------
# 2. Server Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Optional Canonical URL for OAuth callbacks and email links
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# 3. Production OAuth 2.0 Providers (Optional for local test, Recommended for Live)
# ------------------------------------------------------------------------------
# Google OAuth 2.0
# Authorized redirect URI: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth 2.0
# Authorized callback URL: https://yourdomain.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth 2.0
# Authorized redirect URL: https://yourdomain.com/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. Email Dispatch Service
# ------------------------------------------------------------------------------
# Resend API Key for sending live verification codes and application updates
# If omitted, outgoing emails are recorded safely to the database outbox table.
RESEND_API_KEY=
